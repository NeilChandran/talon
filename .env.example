# Copy to backend/.env — never commit real keys

ORIGAMI_API_KEY=og_live_...
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# PostgreSQL (production / docker compose)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/talon

# Local dev without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./backend/talon.db

# Optional — only enable if Redis is running (otherwise searches use in-process background tasks)
# REDIS_URL=redis://localhost:6379/0
TALON_DRY_RUN=0
MAX_LEADS_PER_SEARCH=50
